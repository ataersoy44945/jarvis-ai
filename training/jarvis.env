# Shared settings for serve_vllm.sh, serve_mlx.sh and pipeline.sh
# vllm = NVIDIA QLoRA path (train_lora.py + serve_vllm.sh)
# mlx  = Apple Silicon path (train_mlx.sh + serve_mlx.sh)
TRAIN_BACKEND=mlx
BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
# 4-bit Qwen small enough for an 8 GB M-series Mac
MLX_BASE_MODEL=mlx-community/Qwen2.5-1.5B-Instruct-4bit
# mlx_lm.server maps this request "model" value to --model / --adapter-path.
# backend/.env VLLM_MODEL must be the same string. Any other name is treated as a
# different model path and will not use the Jarvis adapter.
MLX_SERVED_MODEL=default_model
# Short on purpose: this Mac is for a validation run, not a full fine-tune.
MLX_ITERS=100
VLLM_PORT=8001
SERVED_NAME=jarvis          # must match VLLM_MODEL in backend/.env
GPU_MEM_UTIL=0.90
MAX_MODEL_LEN=8192
MAX_LORA_RANK=64
# Where the backend's SQLite DB lives (copy it here if training runs on another machine)
JARVIS_DB=../backend/jarvis.db
# Retrain only when there are at least this many examples, and this many new since last run
MIN_EXAMPLES=50
MIN_NEW_EXAMPLES=25

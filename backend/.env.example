# ---- Which brain does Jarvis use? ----
# openai = OpenAI / Groq / hosted API   |   vllm = your own model served by vLLM
LLM_PROVIDER=openai

# Own model via vLLM (see training/README.md). No API key needed.
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_MODEL=jarvis

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional free Groq instead:
# OPENAI_API_KEY=gsk_your-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*
DATABASE_URL=sqlite:///./jarvis.db
